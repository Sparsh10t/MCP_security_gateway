# Gateway Server
PORT=5000
NODE_ENV=development
UPSTREAM_CONFIG_PATH=./config/upstreams.yaml
UPSTREAM_CALL_TIMEOUT_MS=15000
POLICY_PATH=./policies/policy.yaml

# AuthN (JWT / OIDC)
JWT_SECRET=dev-only-mcp-sentinel-secret-change-me
JWT_ISSUER=mcp-sentinel-dev
JWT_AUDIENCE=mcp-security-gateway
# Optional OIDC JWKS endpoint (e.g. Keycloak):
# JWT_JWKS_URI=http://localhost:8080/realms/mcp/protocol/openid-connect/certs

# Gemini LLM Prompt Injection Analysis (optional; deterministic fallback always active)
GEMINI_API_KEY=your_actual_api_key_here
GEMINI_MODEL=gemini-3.6-flash
GEMINI_TIMEOUT_MS=15000

# PostgreSQL
DATABASE_URL=postgresql://mcp:mcp_secret@localhost:5432/mcp_gateway
POSTGRES_DB=mcp_gateway
POSTGRES_USER=mcp
POSTGRES_PASSWORD=mcp_secret
POSTGRES_PORT=5432

# Redis
REDIS_URL=redis://localhost:6379
REDIS_PORT=6379

# Set to true to fail startup if PostgreSQL or Redis is unreachable
REQUIRE_INFRA=false
